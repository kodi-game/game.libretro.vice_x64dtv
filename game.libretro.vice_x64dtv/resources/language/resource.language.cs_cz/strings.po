msgctxt "#30524"
msgid "Unmapped defaults to joystick down."
msgstr "Není-li tlačítko namapované, výchozí funkcí je směr joysticku dolů."

msgctxt "#30525"
msgid "Unmapped defaults to joystick left."
msgstr "Není-li tlačítko namapované, výchozí funkcí je směr joysticku doleva."

msgctxt "#30526"
msgid "Unmapped defaults to joystick right."
msgstr "Není-li tlačítko namapované, výchozí funkcí je směr joysticku doprava."

msgctxt "#30527"
msgid ""
"Unmapped defaults to fire button.\n"
"VKBD: Press selected key."
msgstr ""
"Není-li tlačítko namapované, výchozí funkcí je tlačítko střelby.\n"
"VKBD: Stiskne vybranou klávesu."

msgctxt "#30528"
msgid ""
"Unmapped defaults to 2nd fire button.\n"
"VKBD: Toggle transparency. Remapping to non-keyboard keys overrides VKBD function!"
msgstr ""
"Není-li tlačítko namapované, výchozí funkcí je druhé tlačítko střelby.\n"
"VKBD: Přepne průhlednost. Přemapování na jiný vstup než klávesu přepíše funkci VKBD!"

msgctxt "#30529"
msgid "VKBD: Toggle 'ShiftLock'. Remapping to non-keyboard keys overrides VKBD function!"
msgstr "VKBD: Přepne 'ShiftLock'. Přemapování na jiný vstup než klávesu přepíše funkci VKBD!"

msgctxt "#30530"
msgid "VKBD: Press 'Space'. Remapping to non-keyboard keys overrides VKBD function!"
msgstr "VKBD: Stiskne 'Space'. Přemapování na jiný vstup než klávesu přepíše funkci VKBD!"

msgctxt "#30531"
msgid "VKBD comes up with RetroPad Select by default."
msgstr "VKBD se ve výchozím nastavení zobrazí tlačítkem Select na RetroPadu."

msgctxt "#30532"
msgid "VKBD: Press 'Return'. Remapping to non-keyboard keys overrides VKBD function!"
msgstr "VKBD: Stiskne 'Return'. Přemapování na jiný vstup než klávesu přepíše funkci VKBD!"

msgctxt "#30533"
msgid "On-Screen Display"
msgstr "OSD"

msgctxt "#30534"
msgid "Configure OSD options."
msgstr "Konfigurovat volby OSD."

msgctxt "#30535"
msgid "The keyboard comes up with RetroPad Select by default."
msgstr "Virtuální klávesnice se ve výchozím nastavení zobrazí tlačítkem Select na RetroPadu."

